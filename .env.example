# Family Budget Tracker - Environment Variables

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Leave empty to allow all users (not recommended for production)
# Get your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=

# Data path for SQLite database (default: ./data)
DATA_PATH=./data

# OpenAI API Key for smart expense classification (optional)
# Get from https://platform.openai.com/api-keys
# If not set, expenses will be classified using keyword matching only
OPENAI_API_KEY=
